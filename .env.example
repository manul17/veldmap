# Copernicus Data Space Ecosystem (CDSE) S3 credentials (eodata).
# Copy this file to `.env` (git-ignored) and fill in your credentials.
#
# Keys are issued in the CDSE portal under Profile -> S3 Credentials:
# https://dataspace.copernicus.eu/
#
# VeldMap builds, runs, and streams zero-auth STAC/COG scenes without these
# keys. CDSE S3 browsing, remote JP2 streaming, and downloads require them.

COPERNICUS_ACCESS_KEY=
COPERNICUS_ACCESS_SECRET=
