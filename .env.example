# Copernicus Data Space Ecosystem (CDSE) S3 credentials (eodata).
# Reserved for Slice 4B (CDSE S3 browsing, remote JP2 streaming, and downloads);
# not read by Slice 1 builds.
#
# Copy this file to `.env` (git-ignored) and fill in your credentials when
# CDSE support lands. Keys are issued under Profile -> S3 Credentials:
# https://dataspace.copernicus.eu/

COPERNICUS_ACCESS_KEY=
COPERNICUS_ACCESS_SECRET=
