# Copernicus Data Space Ecosystem (CDSE) S3 credentials (eodata).
# Reserved for Slice 4B-1 (CDSE S3 browsing, ESA EOPF Zarr cloud streaming,
# and resumable downloads); not yet read by current builds.
#
# When Slice 4B-1 lands, desktop credentials will live in user-local
# `ProjectDirs/.env` (0600 on Unix, written via the Settings UI), with an
# optional git-ignored workspace `.env` override for local development.
# Keys are issued under Profile -> S3 Credentials:
# https://dataspace.copernicus.eu/

COPERNICUS_ACCESS_KEY=
COPERNICUS_ACCESS_SECRET=
